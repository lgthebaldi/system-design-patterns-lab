# Copy to .env and fill in your own values. Never commit .env.

# Infrastructure
MONGO_URI=mongodb://127.0.0.1:27017/triad_system
REDIS_URL=redis://localhost:6379

# Salesforce (OAuth 2.0 connected app)
SF_USERNAME=
SF_PASSWORD=
SF_TOKEN=
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=

# Azure (Entra ID app registration + Blob Storage)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_CONNECTION_STRING=

# AWS: boto3 reads the standard variables or ~/.aws/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Week 5 – Secure Vault master key (long random string)
VAULT_MASTER_KEY=
